GREFFON_BASE_SERVER="http://host.docker.internal:8000"
GREFFON_PATH=/app/data
GREFFER_ADDRESS="host.docker.internal"
GREFFER_PORT="8001"
GREFFER_PROTOCOL="https"
GREFFER_ID="3d4f7760-b346-4a45-a860-a59982c5683f"
GREFFER_SSL_VERIFY=false
# Tunnel mode only — the sidecar polls this URL for its rathole config.
# Proxy-mode greffers can leave it blank.
MANAGER_URL=
# Tunnel mode only — set to ``tunnel`` so the register payload tells
# manager this greffer's intended mode, matching the value set via
# ``PATCH /api/greffer/{id}/mode/``. Empty / unset → manager treats the
# register as proxy-mode-default. Flipping requires updating both
# manager-side mode AND this var, then restarting greffer.
GREFFER_MODE=

# Custom-app disk admission (HLD §9) — enforced at the preflight's
# digest pull, the one pull the platform controls. All operator-owned;
# 0 disables a knob.
#   GREFFER_IMAGE_MAX_BYTES   per-image cap (docker size string or bytes;
#                             default 20g)
#   GREFFER_IMAGE_MIN_FREE_BYTES  keep-free margin refused below
#                             (default 2g; free space reads the data
#                             volume, which shares the disk with the
#                             engine on the standard install)
#   GREFFER_IMAGE_COUNT_MAX   image-count cap (default 0 = OFF — node
#                             images are mostly the catalog tier's
#                             pulls, and charging those to a custom
#                             create refuses tenants for usage they did
#                             not cause)
GREFFER_IMAGE_MAX_BYTES=20g
GREFFER_IMAGE_MIN_FREE_BYTES=2g
GREFFER_IMAGE_COUNT_MAX=0
