services:
  backend:
    depends_on:
    - multica_db
    environment:
      CORS_ALLOWED_ORIGINS: 'https://regress-multica.my.example.test'
      DATABASE_URL: postgres://multica:regress-multica@multica_db:5432/multica?sslmode=disable
      FRONTEND_ORIGIN: 'https://regress-multica.my.example.test'
      JWT_SECRET: ''
      MULTICA_APP_URL: 'https://regress-multica.my.example.test'
      MULTICA_PUBLIC_URL: 'https://regress-multica.my.example.test'
      PORT: '8080'
      RESEND_FROM_EMAIL: 'noreply@example.test'
      SMTP_HOST: 'smtp.example.test'
      SMTP_PASSWORD: 'pw'
      SMTP_PORT: '587'
      SMTP_TLS: 'starttls'
      SMTP_USERNAME: ''
    image: ghcr.io/multica-ai/multica-backend:v0.3.13
    logging:
      driver: json-file
      options:
        max-file: '3'
        max-size: 10m
    restart: on-failure
    volumes:
    - multica_uploads:/app/data/uploads
  multica:
    depends_on:
    - backend
    environment:
      HOSTNAME: 0.0.0.0
    image: ghcr.io/multica-ai/multica-web:v0.3.13
    logging:
      driver: json-file
      options:
        max-file: '3'
        max-size: 10m
    ports:
    - 3000:3000
    restart: on-failure
  multica_db:
    environment:
      POSTGRES_DB: multica
      POSTGRES_PASSWORD: 'regress-multica'
      POSTGRES_USER: multica
    image: pgvector/pgvector:pg17
    logging:
      driver: json-file
      options:
        max-file: '3'
        max-size: 10m
    restart: on-failure
    volumes:
    - multica_db_data:/var/lib/postgresql/data
version: '3'
volumes:
  multica_db_data: null
  multica_uploads: null