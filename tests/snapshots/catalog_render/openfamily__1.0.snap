services:
  app:
    depends_on:
      db:
        condition: service_healthy
    environment:
      CORS_ORIGINS: 'https://regress-openfamily.my.example.test'
      NODE_ENV: production
      POSTGRES_DB: openfamily
      POSTGRES_HOST: db
      POSTGRES_PASSWORD: 'regress-openfamily'
      POSTGRES_PORT: '5432'
      POSTGRES_USER: openfamily
      SERVER_PORT: '3001'
      SERVE_CLIENT_DIR: /app/client
    image: ghcr.io/greffon/openfamily:v1.2.0
    logging:
      driver: json-file
      options:
        max-file: '3'
        max-size: 10m
    ports:
    - 3001:3001
    restart: on-failure
    volumes:
    - openfamily_uploads:/app/uploads
  db:
    environment:
      POSTGRES_DB: openfamily
      POSTGRES_PASSWORD: 'regress-openfamily'
      POSTGRES_USER: openfamily
    healthcheck:
      interval: 5s
      retries: 10
      start_period: 15s
      test:
      - CMD-SHELL
      - pg_isready -h 127.0.0.1 -U openfamily -d openfamily
      timeout: 3s
    image: ghcr.io/greffon/openfamily-db:v1.2.0
    logging:
      driver: json-file
      options:
        max-file: '3'
        max-size: 10m
    restart: on-failure
    volumes:
    - openfamily_db:/var/lib/postgresql/data
version: '3'
volumes:
  openfamily_db: null
  openfamily_uploads: null