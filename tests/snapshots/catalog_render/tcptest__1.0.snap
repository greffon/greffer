services:
  tcptest:
    command:
    - sh
    - -c
    - mkdir -p /srv && printf 'TUNNEL_L4_OK\n' > /srv/index.html && cd /srv && exec
      python -m http.server 9000
    image: python:3.12-alpine
    logging:
      driver: json-file
      options:
        max-file: '3'
        max-size: 10m
    ports:
    - 9000:9000
    restart: unless-stopped
version: '3'