networks:
  greffon_internal_network: {}
services:
  backend:
    command: "sh -c \"python manage.py migrate --no-input &&\n       exec uvicorn\
      \ --app-dir=/app --host=0.0.0.0 --port=8000 --lifespan=off impress.asgi:application\"\
      \n"
    depends_on:
    - postgresql
    - redis
    - minio
    - keycloak
    environment:
      AWS_S3_ACCESS_KEY_ID: ''
      AWS_S3_ENDPOINT_URL: http://minio:9000
      AWS_S3_SECRET_ACCESS_KEY: ''
      AWS_STORAGE_BUCKET_NAME: docs-media-storage
      CELERY_BROKER_URL: redis://redis:6379/1
      COLLABORATION_API_URL: http://y-provider:4444/collaboration/api/
      COLLABORATION_BACKEND_BASE_URL: http://backend:8000
      COLLABORATION_SERVER_ORIGIN: 'https://regress-docs-0.my.example.test'
      COLLABORATION_SERVER_SECRET: ''
      COLLABORATION_WS_URL: wss://regress-docs-0.my.example.test/collaboration/ws/
      DB_HOST: postgresql
      DB_NAME: docs
      DB_PASSWORD: ''
      DB_PORT: '5432'
      DB_USER: docs
      DJANGO_ALLOWED_HOSTS: 'regress-docs-0.my.example.test,regress-docs-0.my.example.test,localhost,backend'
      DJANGO_CONFIGURATION: Production
      DJANGO_CSRF_TRUSTED_ORIGINS: 'https://regress-docs-0.my.example.test'
      DJANGO_EMAIL_FROM: 'noreply@example.test'
      DJANGO_EMAIL_HOST: 'smtp.example.test'
      DJANGO_EMAIL_HOST_PASSWORD: 'pw'
      DJANGO_EMAIL_HOST_USER: 'mailer@example.test'
      DJANGO_EMAIL_PORT: '587'
      DJANGO_EMAIL_USE_SSL: 'false'
      DJANGO_EMAIL_USE_TLS: 'true'
      DJANGO_SECRET_KEY: ''
      DJANGO_SETTINGS_MODULE: impress.settings
      LOGIN_REDIRECT_URL: 'https://regress-docs-0.my.example.test'
      LOGIN_REDIRECT_URL_FAILURE: 'https://regress-docs-0.my.example.test'
      LOGOUT_REDIRECT_URL: 'https://regress-docs-0.my.example.test'
      MEDIA_BASE_URL: 'https://regress-docs-0.my.example.test'
      OIDC_AUTH_REQUEST_EXTRA_PARAMS: '{"login_hint": "demo"}'
      OIDC_OP_AUTHORIZATION_ENDPOINT: 'https://regress-docs-0.my.example.test/identity/realms/docs/protocol/openid-connect/auth'
      OIDC_OP_JWKS_ENDPOINT: http://keycloak:8080/identity/realms/docs/protocol/openid-connect/certs
      OIDC_OP_LOGOUT_ENDPOINT: 'https://regress-docs-0.my.example.test/identity/realms/docs/protocol/openid-connect/logout'
      OIDC_OP_TOKEN_ENDPOINT: http://keycloak:8080/identity/realms/docs/protocol/openid-connect/token
      OIDC_OP_USER_ENDPOINT: http://keycloak:8080/identity/realms/docs/protocol/openid-connect/userinfo
      OIDC_REDIRECT_ALLOWED_HOSTS: '["https://regress-docs-0.my.example.test"]'
      OIDC_RP_CLIENT_ID: docs
      OIDC_RP_CLIENT_SECRET: ''
      OIDC_RP_SCOPES: openid email
      OIDC_RP_SIGN_ALGO: RS256
      PYTHONPATH: /app
      REDIS_URL: redis://redis:6379/0
      Y_PROVIDER_API_BASE_URL: http://y-provider:4444/api/
      Y_PROVIDER_API_KEY: ''
    image: lasuite/impress-backend:v5.2.1
    logging:
      driver: json-file
      options:
        max-file: '3'
        max-size: 10m
    networks:
    - greffon_internal_network
    ports: []
    restart: on-failure
    volumes: []
  celery:
    command:
    - celery
    - -A
    - impress.celery_app
    - worker
    - -l
    - INFO
    depends_on:
    - backend
    environment:
      AWS_S3_ACCESS_KEY_ID: ''
      AWS_S3_ENDPOINT_URL: http://minio:9000
      AWS_S3_SECRET_ACCESS_KEY: ''
      AWS_STORAGE_BUCKET_NAME: docs-media-storage
      CELERY_BROKER_URL: redis://redis:6379/1
      DB_HOST: postgresql
      DB_NAME: docs
      DB_PASSWORD: ''
      DB_PORT: '5432'
      DB_USER: docs
      DJANGO_CONFIGURATION: Production
      DJANGO_SETTINGS_MODULE: impress.settings
      PYTHONPATH: /app
      REDIS_URL: redis://redis:6379/0
    image: lasuite/impress-backend:v5.2.1
    logging:
      driver: json-file
      options:
        max-file: '3'
        max-size: 10m
    networks:
    - greffon_internal_network
    ports: []
    restart: on-failure
    volumes: []
  createbuckets:
    depends_on:
    - minio
    entrypoint: 'sh -c " until /usr/bin/mc alias set docs http://minio:9000 "$$MINIO_ROOT_USER"
      "$$MINIO_ROOT_PASSWORD"; do sleep 2; done && /usr/bin/mc mb --ignore-existing
      docs/docs-media-storage && /usr/bin/mc version enable docs/docs-media-storage
      && exit 0;"

      '
    environment:
    - MINIO_ROOT_USER=
    - MINIO_ROOT_PASSWORD=
    image: minio/mc
    labels:
      com.greffon.status: ignore
    logging:
      driver: json-file
      options:
        max-file: '3'
        max-size: 10m
    networks:
    - greffon_internal_network
    ports: []
    restart: on-failure
    volumes: []
  frontend:
    depends_on:
    - backend
    image: lasuite/impress-frontend:v5.2.1
    logging:
      driver: json-file
      options:
        max-file: '3'
        max-size: 10m
    networks:
    - greffon_internal_network
    ports: []
    restart: on-failure
    volumes: []
  gateway:
    depends_on:
    - backend
    - frontend
    - y-provider
    - keycloak
    - minio
    image: nginx:1.25
    logging:
      driver: json-file
      options:
        max-file: '3'
        max-size: 10m
    networks:
    - greffon_internal_network
    ports: []
    restart: on-failure
    volumes:
    - regress-docs_gateway_conf:/etc/nginx/conf.d
  greffon_nginx:
    image: nginx:1.20.2-alpine-perl
    logging:
      driver: json-file
      options:
        max-file: '3'
        max-size: 10m
    networks:
    - greffon_internal_network
    ports:
    - '20000:8083'
    restart: unless-stopped
    volumes:
    - regress-docs_nginx_volume:/etc/nginx/
  keycloak:
    command:
    - start-dev
    - --import-realm
    environment:
      KC_BOOTSTRAP_ADMIN_PASSWORD: ''
      KC_BOOTSTRAP_ADMIN_USERNAME: admin
      KC_HOSTNAME: 'https://regress-docs-0.my.example.test/identity'
      KC_HOSTNAME_STRICT: 'false'
      KC_HTTP_ENABLED: 'true'
      KC_HTTP_RELATIVE_PATH: /identity
      KC_PROXY_HEADERS: xforwarded
    image: quay.io/keycloak/keycloak:26.3
    logging:
      driver: json-file
      options:
        max-file: '3'
        max-size: 10m
    networks:
    - greffon_internal_network
    ports: []
    restart: on-failure
    volumes:
    - regress-docs_keycloak_import:/opt/keycloak/data/import
  minio:
    command: minio server --console-address ":9001" /data
    environment:
    - MINIO_ROOT_USER=
    - MINIO_ROOT_PASSWORD=
    image: minio/minio
    logging:
      driver: json-file
      options:
        max-file: '3'
        max-size: 10m
    networks:
    - greffon_internal_network
    ports: []
    restart: on-failure
    volumes:
    - regress-docs_minio_data:/data
  postgresql:
    environment:
      POSTGRES_DB: docs
      POSTGRES_PASSWORD: ''
      POSTGRES_USER: docs
    healthcheck:
      interval: 10s
      retries: 5
      test:
      - CMD-SHELL
      - pg_isready -h 127.0.0.1 -U docs -d docs
      timeout: 5s
    image: postgres:16
    labels:
      com.greffon.backup.dump: pg_dump -U docs -d docs -Fc
      com.greffon.backup.restore: pg_restore -U docs -d docs --clean --if-exists --no-owner
        --single-transaction
    logging:
      driver: json-file
      options:
        max-file: '3'
        max-size: 10m
    networks:
    - greffon_internal_network
    ports: []
    restart: on-failure
    volumes:
    - regress-docs_postgres_data:/var/lib/postgresql/data
  redis:
    image: redis:5
    logging:
      driver: json-file
      options:
        max-file: '3'
        max-size: 10m
    networks:
    - greffon_internal_network
    ports: []
    restart: on-failure
    volumes: []
  y-provider:
    environment:
      COLLABORATION_API_URL: http://y-provider:4444/collaboration/api/
      COLLABORATION_BACKEND_BASE_URL: http://backend:8000
      COLLABORATION_LOGGING: 'true'
      COLLABORATION_SERVER_ORIGIN: 'https://regress-docs-0.my.example.test'
      COLLABORATION_SERVER_SECRET: ''
      Y_PROVIDER_API_BASE_URL: http://y-provider:4444/api/
      Y_PROVIDER_API_KEY: ''
    image: lasuite/impress-y-provider:v5.2.1
    logging:
      driver: json-file
      options:
        max-file: '3'
        max-size: 10m
    networks:
    - greffon_internal_network
    ports: []
    restart: on-failure
    volumes: []
version: '3'
volumes:
  regress-docs_gateway_conf:
    name: regress-docs_gateway_conf
  regress-docs_keycloak_import:
    name: regress-docs_keycloak_import
  regress-docs_minio_data:
    name: regress-docs_minio_data
  regress-docs_nginx_volume:
    name: regress-docs_nginx_volume
  regress-docs_postgres_data:
    name: regress-docs_postgres_data