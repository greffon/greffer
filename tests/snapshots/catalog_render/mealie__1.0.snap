networks:
  greffon_internal_network: {}
services:
  greffon_nginx:
    image: nginx:1.20.2-alpine-perl
    logging:
      driver: json-file
      options:
        max-file: '3'
        max-size: 10m
    networks:
    - greffon_internal_network
    ports:
    - '20000:9000'
    restart: unless-stopped
    volumes:
    - regress-mealie_nginx_volume:/etc/nginx/
  mealie:
    environment:
      ALLOW_SIGNUP: 'false'
      BASE_URL: 'https://regress-mealie-0.my.example.test'
      SMTP_AUTH_STRATEGY: 'TLS'
      SMTP_FROM_EMAIL: 'noreply@example.test'
      SMTP_HOST: 'smtp.example.test'
      SMTP_PASSWORD: 'pw'
      SMTP_PORT: '587'
      SMTP_USER: 'mailer@example.test'
    image: ghcr.io/mealie-recipes/mealie:v3.19.2
    logging:
      driver: json-file
      options:
        max-file: '3'
        max-size: 10m
    networks:
    - greffon_internal_network
    ports: []
    restart: on-failure
    volumes:
    - regress-mealie_mealie_data:/app/data
version: '3'
volumes:
  regress-mealie_mealie_data:
    name: regress-mealie_mealie_data
  regress-mealie_nginx_volume:
    name: regress-mealie_nginx_volume