services:
  mealie:
    environment:
      ALLOW_SIGNUP: 'false'
      BASE_URL: 'https://regress-mealie.my.example.test'
      SMTP_AUTH_STRATEGY: 'TLS'
      SMTP_FROM_EMAIL: 'noreply@example.test'
      SMTP_HOST: 'smtp.example.test'
      SMTP_PASSWORD: 'pw'
      SMTP_PORT: '587'
      SMTP_USER: ''
    image: ghcr.io/mealie-recipes/mealie:v3.19.2
    logging:
      driver: json-file
      options:
        max-file: '3'
        max-size: 10m
    ports:
    - 9000:9000
    restart: on-failure
    volumes:
    - mealie_data:/app/data
version: '3'
volumes:
  mealie_data: null