services:
  grafana:
    environment:
      GF_SECURITY_ADMIN_PASSWORD: ''
      GF_SECURITY_SECRET_KEY: ''
      GF_SERVER_ROOT_URL: 'https://regress-grafana.my.example.test'
      GF_SMTP_ENABLED: 'true'
      GF_SMTP_FROM_ADDRESS: 'noreply@example.test'
      GF_SMTP_HOST: 'smtp.example.test:587'
      GF_SMTP_PASSWORD: 'pw'
      GF_SMTP_STARTTLS_POLICY: 'MandatoryStartTLS'
      GF_SMTP_USER: ''
    image: grafana/grafana:12.2.1
    logging:
      driver: json-file
      options:
        max-file: '3'
        max-size: 10m
    ports:
    - 3000:3000
    restart: on-failure
    user: '0'
    volumes:
    - grafana_data:/var/lib/grafana
version: '3'
volumes:
  grafana_data: null