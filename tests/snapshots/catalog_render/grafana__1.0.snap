networks:
  greffon_internal_network: {}
services:
  grafana:
    environment:
      GF_SECURITY_ADMIN_PASSWORD: ''
      GF_SECURITY_SECRET_KEY: ''
      GF_SERVER_ROOT_URL: 'https://regress-grafana-0.my.example.test'
      GF_SMTP_ENABLED: 'true'
      GF_SMTP_FROM_ADDRESS: 'noreply@example.test'
      GF_SMTP_HOST: 'smtp.example.test:587'
      GF_SMTP_PASSWORD: 'pw'
      GF_SMTP_STARTTLS_POLICY: 'MandatoryStartTLS'
      GF_SMTP_USER: 'mailer@example.test'
    image: grafana/grafana:12.2.1
    logging:
      driver: json-file
      options:
        max-file: '3'
        max-size: 10m
    networks:
    - greffon_internal_network
    ports: []
    restart: on-failure
    user: '0'
    volumes:
    - regress-grafana_grafana_data:/var/lib/grafana
  greffon_nginx:
    image: nginx:1.20.2-alpine-perl
    logging:
      driver: json-file
      options:
        max-file: '3'
        max-size: 10m
    networks:
    - greffon_internal_network
    ports:
    - '20000:3000'
    restart: unless-stopped
    volumes:
    - regress-grafana_nginx_volume:/etc/nginx/
version: '3'
volumes:
  regress-grafana_grafana_data:
    name: regress-grafana_grafana_data
  regress-grafana_nginx_volume:
    name: regress-grafana_nginx_volume