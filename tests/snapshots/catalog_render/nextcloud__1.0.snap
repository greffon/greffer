networks:
  greffon_internal_network: {}
services:
  greffon_nginx:
    image: nginx:1.20.2-alpine-perl
    logging:
      driver: json-file
      options:
        max-file: '3'
        max-size: 10m
    networks:
    - greffon_internal_network
    ports:
    - '20000:80'
    restart: unless-stopped
    volumes:
    - regress-nextcloud_nginx_volume:/etc/nginx/
  nextcloud:
    depends_on:
    - nextcloud_db
    environment:
      MAIL_DOMAIN: 'example.test'
      MAIL_FROM_ADDRESS: 'noreply'
      NEXTCLOUD_ADMIN_PASSWORD: ''
      NEXTCLOUD_ADMIN_USER: admin
      NEXTCLOUD_TRUSTED_DOMAINS: 'regress-nextcloud-0.my.example.test regress-nextcloud-0.my.example.test localhost'
      OVERWRITECLIURL: 'https://regress-nextcloud-0.my.example.test'
      OVERWRITEPROTOCOL: https
      POSTGRES_DB: nextcloud
      POSTGRES_HOST: nextcloud_db
      POSTGRES_PASSWORD: postgres
      POSTGRES_USER: postgres
      SMTP_HOST: 'smtp.example.test'
      SMTP_NAME: 'mailer@example.test'
      SMTP_PASSWORD: 'pw'
      SMTP_PORT: '587'
      SMTP_SECURE: 'tls'
    image: nextcloud:latest
    logging:
      driver: json-file
      options:
        max-file: '3'
        max-size: 10m
    networks:
    - greffon_internal_network
    ports: []
    volumes:
    - regress-nextcloud_nextcloud_data:/var/www/html
  nextcloud_db:
    environment:
      POSTGRES_DB: nextcloud
      POSTGRES_PASSWORD: postgres
    image: postgres:14-alpine
    logging:
      driver: json-file
      options:
        max-file: '3'
        max-size: 10m
    networks:
    - greffon_internal_network
    ports: []
    volumes:
    - regress-nextcloud_db_data:/var/lib/postgresql/data
version: '3'
volumes:
  regress-nextcloud_db_data:
    name: regress-nextcloud_db_data
  regress-nextcloud_nextcloud_data:
    name: regress-nextcloud_nextcloud_data
  regress-nextcloud_nginx_volume:
    name: regress-nextcloud_nginx_volume