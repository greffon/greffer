services:
  nextcloud:
    depends_on:
    - nextcloud_db
    environment:
      MAIL_DOMAIN: 'example.test'
      MAIL_FROM_ADDRESS: 'noreply'
      POSTGRES_DB: nextcloud
      POSTGRES_HOST: nextcloud_db
      POSTGRES_PASSWORD: postgres
      POSTGRES_USER: postgres
      SMTP_HOST: 'smtp.example.test'
      SMTP_NAME: ''
      SMTP_PASSWORD: 'pw'
      SMTP_PORT: '587'
      SMTP_SECURE: 'tls'
    image: nextcloud:latest
    logging:
      driver: json-file
      options:
        max-file: '3'
        max-size: 10m
    ports:
    - 8080:80
    volumes:
    - nextcloud_data:/var/www/html
  nextcloud_db:
    environment:
      POSTGRES_DB: nextcloud
      POSTGRES_PASSWORD: postgres
    image: postgres:14-alpine
    logging:
      driver: json-file
      options:
        max-file: '3'
        max-size: 10m
    volumes:
    - db_data:/var/lib/postgresql/data
version: '3'
volumes:
  db_data: null
  nextcloud_data: null