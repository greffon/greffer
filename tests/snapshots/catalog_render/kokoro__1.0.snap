services:
  tts:
    image: ghcr.io/remsky/kokoro-fastapi-cpu:latest
    logging:
      driver: json-file
      options:
        max-file: '3'
        max-size: 10m
  web:
    command:
    - sh
    - -c
    - printf '%s' 'server { listen 80; absolute_redirect off; resolver 127.0.0.11
      ipv6=off valid=5s; set $$u tts; location = / { return 302 /web/; } location
      / { proxy_pass http://$$u:8880; proxy_set_header Host $$host; proxy_set_header
      X-Forwarded-For $$proxy_add_x_forwarded_for; proxy_read_timeout 120s; } }' >
      /etc/nginx/conf.d/default.conf && exec nginx -g 'daemon off;'
    depends_on:
    - tts
    image: nginx:alpine
    logging:
      driver: json-file
      options:
        max-file: '3'
        max-size: 10m
    ports:
    - 80:80
version: '3'