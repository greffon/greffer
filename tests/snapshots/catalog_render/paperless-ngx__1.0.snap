services:
  paperless:
    depends_on:
    - paperless_broker
    environment:
      PAPERLESS_ADMIN_PASSWORD: ''
      PAPERLESS_ADMIN_USER: admin
      PAPERLESS_DBENGINE: sqlite
      PAPERLESS_EMAIL_FROM: 'noreply@example.test'
      PAPERLESS_EMAIL_HOST: 'smtp.example.test'
      PAPERLESS_EMAIL_HOST_PASSWORD: 'pw'
      PAPERLESS_EMAIL_HOST_USER: ''
      PAPERLESS_EMAIL_PORT: '587'
      PAPERLESS_EMAIL_USE_SSL: 'false'
      PAPERLESS_EMAIL_USE_TLS: 'true'
      PAPERLESS_OCR_LANGUAGE: eng
      PAPERLESS_REDIS: redis://paperless_broker:6379
      PAPERLESS_SECRET_KEY: ''
      PAPERLESS_URL: 'https://regress-paperless-ngx.my.example.test'
    image: ghcr.io/paperless-ngx/paperless-ngx:2.20.15
    logging:
      driver: json-file
      options:
        max-file: '3'
        max-size: 10m
    ports:
    - 8000:8000
    restart: on-failure
    volumes:
    - paperless_data:/usr/src/paperless/data
    - paperless_media:/usr/src/paperless/media
    - paperless_consume:/usr/src/paperless/consume
  paperless_broker:
    image: redis:8
    logging:
      driver: json-file
      options:
        max-file: '3'
        max-size: 10m
    restart: on-failure
    volumes:
    - paperless_redis:/data
version: '3'
volumes:
  paperless_consume: null
  paperless_data: null
  paperless_media: null
  paperless_redis: null